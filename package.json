{
  "name": "edugames",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "common",
    "achievements",
    "hub",
    "games/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "serve": "node scripts/serve.mjs",
    "test:browser": "node scripts/browser-test.mjs scripts/tests/multiply-play.mjs",
    "test:ui": "node scripts/browser-test.mjs scripts/tests/container-ui.mjs",
    "test:hub": "node scripts/browser-test.mjs scripts/tests/hub.mjs",
    "test:garden": "node scripts/browser-test.mjs scripts/tests/garden.mjs",
    "test:achievements": "node scripts/browser-test.mjs scripts/tests/achievements-game.mjs",
    "test:letters": "node scripts/browser-test.mjs scripts/tests/letters-play.mjs",
    "test:letters-save": "node scripts/browser-test.mjs scripts/tests/letters-save.mjs",
    "test:shared-object": "node scripts/browser-test.mjs scripts/tests/shared-object.mjs",
    "deploy": "yarn build && node scripts/deploy.mjs",
    "deploy:dry": "yarn build && node scripts/deploy.mjs --dry-run",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy -c worker/wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
