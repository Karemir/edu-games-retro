<UserControl x:Class="QuestionsSL.QuestionListEntry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Margin="3"
    d:DesignHeight="50" d:DesignWidth="700">
    
    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.Effect>
            <DropShadowEffect ShadowDepth="0"/>
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <RadioButton Margin="3" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
        <TextBox x:Name="tagName" Width="500" Grid.Column="1" Text="{Binding Mode=TwoWay, Path=QuestionText}" IsReadOnly="True" Background="Transparent" FontSize="12" VerticalAlignment="Center" BorderBrush="{x:Null}"/>
        <Button Grid.Column="2" Margin="5" Width="60" Click="DoEdit">Edytuj</Button>
        <Button Grid.Column="3" Margin="5" Width="60" Click="DoDelete">Usuń</Button>
    </Grid>
</UserControl>
