<UserControl x:Class="QuestionsSL.QuestionEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="500" d:DesignWidth="400">

    <Grid x:Name="LayoutRoot" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Header" Text="NOWE PYTANIE" FontWeight="Bold" FontSize="25" Grid.ColumnSpan="2"/>

        <TextBlock Text="Treść pytania: " HorizontalAlignment="Right" Grid.Row="1" Width="82" />
        <TextBlock Text="Tagi: " HorizontalAlignment="Right" Grid.Row="2" Width="31"/>
        <TextBlock Text="Epoka: " HorizontalAlignment="Right" Grid.Row="3" Width="42"/>

        <TextBox x:Name="questionText" Grid.Row="1" Grid.Column="1" Width="250" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=QuestionText}"/>
        <TextBox x:Name="tags" Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=SimiliarTags}"/>
        <ComboBox x:Name="epochs" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectedIndex="{Binding Mode=TwoWay, Path=EpochId}"/>

        <TextBlock Text="Odp 1: " HorizontalAlignment="Right" Grid.Row="4" Width="54" VerticalAlignment="Center" Height="16" Margin="0,42"/>
        <Image x:Name="img1" Width="100" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="150,0,0,0">
            <Button Width="90" Click="AddImg1">Zmień</Button>
            <Button Width="90" Click="DelImg1">Usuń</Button>
        </StackPanel>
        
        <TextBlock Text="Odp 2: " HorizontalAlignment="Right" Grid.Row="5" Width="54" VerticalAlignment="Center" Height="16" Margin="0,42"/>
        <Image x:Name="img2" Width="100" Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Grid.Row="5" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="150,0,0,0" >
            <Button Width="90" Click="AddImg2">Zmień</Button>
            <Button Width="90" Click="DelImg2">Usuń</Button>
        </StackPanel>
        
        <TextBlock Text="Odp 3: " HorizontalAlignment="Right" Grid.Row="6" Width="54" VerticalAlignment="Center" Height="16" Margin="0,42"/>
        <Image x:Name="img3" Width="100" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Left" />
        <StackPanel Grid.Column="1" Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="150,0,0,0" >
            <Button Width="90" Click="AddImg3">Zmień</Button>
            <Button Width="90" Click="DelImg3">Usuń</Button>
        </StackPanel>

        <StackPanel Margin="10,10,0,0" Orientation="Horizontal" Grid.Column="1" Grid.Row="7" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Width="180">
            <Button Width="90" Height="40" Click="SaveClick">Zapisz</Button>
            <Button Width="90" Height="40" Click="CancelClick">Anuluj</Button>
        </StackPanel>
    </Grid>
</UserControl>
