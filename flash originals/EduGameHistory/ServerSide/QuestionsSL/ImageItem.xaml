<UserControl x:Class="QuestionsSL.ImageItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="100" d:DesignWidth="100">
    
    <Border Background="#FFFFE2B8" CornerRadius="10" >
        <Grid x:Name="LayoutRoot" Background="White" Margin="5">
            <Image Grid.ColumnSpan="2" x:Name="visImg" Height="100" Width="100" />
            <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Click="DoRemove">X</Button>
        </Grid>
    </Border>
</UserControl>
