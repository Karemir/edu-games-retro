<UserControl x:Class="QuestionsSL.ImageEdit"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="400">
    
    <Grid x:Name="LayoutRoot" Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="71*"/>
            <ColumnDefinition Width="329*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Header" Text="NOWE ZDJĘCIE" FontWeight="Bold" FontSize="25" Grid.ColumnSpan="2"/>
        
        <TextBlock Text="Obrazek: " HorizontalAlignment="Right" Grid.Row="1" Width="54" VerticalAlignment="Center"/>
        <TextBlock Text="Opis: " HorizontalAlignment="Right" Grid.Row="2" Width="33"/>
        <TextBlock Text="Tagi: " HorizontalAlignment="Right" Grid.Row="3" Width="31"/>
        <TextBlock Text="Link: " HorizontalAlignment="Right" Grid.Row="4" Width="31"/>
        <TextBlock Text="Epoka: " HorizontalAlignment="Right" Grid.Row="5" Width="42"/>

        <Image x:Name="img" Width="100" Height="100" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" />
        <Button Grid.Column="1" Grid.Row="1" Height="30" Width="90" HorizontalAlignment="Left" Margin="150,0,0,0" Click="AddImg">Dodaj</Button>
        <TextBox x:Name="description" Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=Description}"/>
        <TextBox x:Name="tags" Grid.Row="3" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=TagStrings}"/>
        <TextBox x:Name="link" Grid.Row="4" Grid.Column="1" Width="150" HorizontalAlignment="Left" Text="{Binding Mode=TwoWay, Path=Link}"/>
        <ComboBox x:Name="epochs" Grid.Row="5" Grid.Column="1" Width="150" HorizontalAlignment="Left" SelectedIndex="{Binding Mode=TwoWay, Path=EpochId}"/>

        <StackPanel Margin="10" Orientation="Horizontal" Grid.Column="1" Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button Width="90" Height="40" Click="Button_Click_1">Zapisz</Button>
            <Button Width="90" Height="40" Click="CancelClick">Anuluj</Button>
        </StackPanel>
    </Grid>
</UserControl>
