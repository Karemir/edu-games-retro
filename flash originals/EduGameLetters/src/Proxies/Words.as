		public function GetWords(letterCount:int):Array {
			var keys:Array = [];
			for (var key:* in sounds) {
				if(key.length == letterCount){
					keys.push(key);
				}
			}
			return keys;
		}
		
		public function PlaySound(word:String):void {
			var sound:Sounds = AppFacade.GetInstance().retrieveProxy(Sounds.NAME) as Sounds;
			if(sound.soundsEnabled){
				sounds[word].play();
			}
		}
		
